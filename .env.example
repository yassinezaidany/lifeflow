# ---------------------------------------------------------------------------
# LifeFlow environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# MySQL (docker-compose exposes MySQL on 3307 by default)
DB_NAME=lifeflow
DB_USER=lifeflow
DB_PASSWORD=lifeflow
DB_HOST=127.0.0.1
DB_PORT=3307
DB_ROOT_PASSWORD=root

# Email (console backend prints emails, e.g. password reset links, in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=LifeFlow <no-reply@lifeflow.local>

# Defaults for new users
DEFAULT_TIMEZONE=Africa/Casablanca
