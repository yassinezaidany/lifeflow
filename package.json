{
  "name": "lifeflow",
  "version": "1.0.0",
  "private": true,
  "description": "LifeFlow frontend assets (Tailwind, Alpine.js, Chart.js, Lucide sprite)",
  "scripts": {
    "build:assets": "node frontend/build.js",
    "build:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/input.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/input.css -o static/css/app.css --watch",
    "build": "npm run build:assets && npm run build:css"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.17.4",
    "@alpinejs/focus": "^3.17.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "alpinejs": "^3.17.4",
    "chart.js": "^4.5.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "lucide-static": "^1.50.0",
    "tailwindcss": "^3.4.19"
  }
}
